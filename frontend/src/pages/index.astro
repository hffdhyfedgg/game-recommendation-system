---
import AppLayout from '../components/ui/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import { getToken } from '../client/api';

// Проверка авторизации на клиенте (после загрузки страницы)
// В SSR-режиме мы не можем использовать localStorage, поэтому редирект выполняется в браузере
const hasToken = typeof window !== 'undefined' ? getToken() : null;
---

<AppLayout pageType="auth" title="PlayNext | Sign In">
  <div class="auth-layout">
    <section class="auth-hero">
      <div class="brand-badge">PlayNext</div>
      <h1>Find your next favorite game.</h1>
      <p>
        Discover games that match your mood, save favorite genres,
        rate titles, and share your opinion with other players.
      </p>
    </section>

    <section class="auth-panel">
      <div class="auth-card">
        <div class="tabs">
          <button class="tab-button active" data-auth-tab="login" type="button">Sign In</button>
          <button class="tab-button" data-auth-tab="register" type="button">Register</button>
        </div>

        <div class="auth-copy">
          <h2 id="authTitle">Welcome back</h2>
          <p id="authSubtitle">Use your email and password to enter PlayNext.</p>
        </div>

        <form id="loginForm" class="auth-form">
          <Field type="email" name="email" label="Email" placeholder="your@email.com" required />
          <Field type="password" name="password" label="Password" placeholder="Minimum 6 characters" required />
          <Button variant="primary" type="submit" class="auth-submit">Sign In</Button>
        </form>

        <form id="registerForm" class="auth-form hidden">
          <Field type="text" name="username" label="Username" placeholder="Choose a username" minlength={3} required />
          <Field type="email" name="email" label="Email" placeholder="your@email.com" required />
          <Field type="password" name="password" label="Password" placeholder="Minimum 6 characters" minlength={6} required />
          <Button variant="primary" type="submit" class="auth-submit">Create Account</Button>
        </form>

        <p class="auth-note">
          Sign in to manage your profile, preferences, ratings, and reviews.
        </p>
      </div>
    </section>
  </div>

  <script type="module" src="../client/auth.ts"></script>
</AppLayout>
