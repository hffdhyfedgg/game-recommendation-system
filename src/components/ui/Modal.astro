---
export interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div id={id} class="modal hidden">
  <div class="modal-card">
    <div class="modal-head">
      <h3>{title}</h3>
      <button class="icon-button" id={`close-${id}`} type="button">X</button>
    </div>
    <slot />
  </div>
</div>
