---
export interface Props {
  label: string;
  type?: 'text' | 'email' | 'password' | 'textarea' | 'search';
  name: string;
  placeholder?: string;
  required?: boolean;
  minlength?: number;
  value?: string;
}

const { 
  label, 
  type = 'text', 
  name, 
  placeholder = '', 
  required = false, 
  minlength,
  value = ''
} = Astro.props;
---

{type === 'textarea' ? (
  <label class="field">
    <span>{label}</span>
    <textarea name={name} placeholder={placeholder} required={required} minlength={minlength} value={value}></textarea>
  </label>
) : type === 'search' ? (
  <label class="search-field">
    <input type="search" name={name} placeholder={placeholder} required={required} minlength={minlength} value={value} />
  </label>
) : (
  <label class="field">
    <span>{label}</span>
    <input type={type} name={name} placeholder={placeholder} required={required} minlength={minlength} value={value} />
  </label>
)}
